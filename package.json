{
  "name": "ticket-bot",
  "version": "1.0.0",
  "description": "工单系统机器人 - 检测源多维表格指定字段，整理写入目标多维表格，并按字段值路由到不同群聊播报",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "deploy": "node push.js",
    "push": "node push.js",
    "test": "npm run test:multi-accept && npm run test:sync && npm run test:unclosed && npm run test:workload && npm run test:quiet-flush",
    "test:multi-accept": "node scripts/stub-test-multi-accept.js",
    "test:sync": "node scripts/stub-test-sync.js",
    "test:unclosed": "node scripts/stub-test-unclosed.js",
    "test:workload": "node scripts/stub-test-workload.js",
    "test:quiet-flush": "node scripts/stub-test-quiet-flush.js"
  },
  "keywords": [
    "feishu",
    "bitable",
    "ticket",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.2.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
