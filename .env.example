# ============================================================
# ticket-bot 工单系统机器人配置模板
# 复制为 .env 并填写实际值；.env 不入库
# 飞书应用沿用 qianli 项目群共用应用
# ============================================================

# 服务器端口
PORT=3003

# 飞书应用配置（共用应用凭证）
APP_ID=
APP_SECRET=

# ---------------- 源表：工单录入表 ----------------
# 源表所在多维表格 app_token
BITABLE_APP_TOKEN=
# 源表 table_id（机器人监听该表的记录变更）
SOURCE_TABLE_ID=

# ---------------- 目标表：项目看板 ----------------
# 目标表所在多维表格 app_token（留空则与源表同一多维表格）
TARGET_BITABLE_APP_TOKEN=
# 目标表 table_id
TARGET_TABLE_ID=

# 同步查重字段：目标表中存放「源记录 record_id」的字段名（文本类型）
SYNC_KEY_FIELD=源记录ID
# 门控字段：仅当该字段有值时搬运到项目看板
CATEGORY_FIELD=category

# ---------------- 工单播报 ----------------
# 路由字段（多选：机械组/电控组/硬件组/宣运组/视觉组/管理层）
ROUTE_FIELD=面向组别
# 标题字段（超链接类型，展示时只取文本）
TITLE_FIELD=申请编号
# 状态字段
STATUS_FIELD=申请状态
# 待处理状态值（留空则不列待处理明细）
PENDING_STATUS=
# 播报卡片展示字段（逗号分隔）
DISPLAY_FIELDS=需求1,发起人,理想结单时间,发起人部门,相关说明

# 「是否指定人员负责」分支
ASSIGN_FIELD=是否指定人员负责
ASSIGN_YES_VALUE=是
ASSIGN_NO_VALUE=否
# 指定负责人字段（人员类型）
ASSIGNEE_FIELD=指定负责人
# 接单确认后，将接单人写入源表该字段（人员类型）
SUPPLEMENT_ASSIGNEE_FIELD=补充负责人
# 人员所属组别映射（姓名或open_id:组别名），优先级最高
USER_GROUPS=

# 组别 → 群聊路由
# 格式：组别名=chat_id|webhook_url，逗号分隔（chat_id 用于 @人，webhook_url 用于发消息）
GROUP_ROUTES=
# 兜底群（组别无匹配时）
DEFAULT_CHAT_ID=

# 组长映射（组别名:组长open_id或姓名），用于超时工单重问询时 @组长
GROUP_LEADERS=

# 播报时机（create/update，逗号分隔）
BROADCAST_ON=create
# 播报标记字段（写回源表，跨重启防重播；长连接事件可能被共用应用的其他连接抢走，由每分钟对账兜底）
# 留空则禁用标记（不推荐，重启后可能重复播报）
BROADCAST_MARK_FIELD=已播报

# ---------------- 审批节点监听 ----------------
# 审批节点字段名
APPROVAL_NODE_FIELD=审批节点
# 触发播报 / 6小时未接单判断的节点值（逗号分隔多个）
# 有组员接单后通过=未指定负责人工单；负责人确认消息后通过=指定负责人工单
APPROVAL_NODE_ACCEPT_VALUE=有组员接单后通过,负责人确认消息后通过
# 触发结单提醒的节点值
APPROVAL_NODE_CLOSE_VALUE=回执单：是否结单

# ---------------- 结单提醒 ----------------
# 理想结单时间字段
DEADLINE_FIELD=理想结单时间
# 临近理想结单时间前 N 天提醒
CLOSE_REMINDER_LEAD_DAYS=1

# ---------------- 飞书事件订阅（长连接） ----------------
FEISHU_USE_LONG_CONNECTION=true
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 机器人名称（接单提示文案中使用）
BOT_NAME=爆米花机_自动型

# ---------------- 每日汇总播报 ----------------
# cron 表达式（秒 分 时 日 月 周），留空则不启用
CRON_SCHEDULE=
