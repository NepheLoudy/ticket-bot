# ============================================================
# ticket-bot 工单系统机器人配置
# 飞书应用沿用 qianli 项目群共用应用（与 knowledge-tracker /
# bambu-print-server / approval-bot 同一个 App）
# ============================================================

# 服务器配置
PORT=3003

# 飞书应用配置（共用应用凭证）
APP_ID=cli_aac7e6f6cdf8dcc0
APP_SECRET=

# ---------------- 源表：工单录入表 ----------------
# 源表所在多维表格 app_token
BITABLE_APP_TOKEN=
# 源表 table_id（机器人监听该表的记录变更）
SOURCE_TABLE_ID=

# ---------------- 目标表：整理后的工单表 ----------------
# 目标表所在多维表格 app_token（留空则与源表同一个多维表格）
TARGET_BITABLE_APP_TOKEN=
# 目标表 table_id
TARGET_TABLE_ID=

# ---------------- 字段映射（同步整理规则） ----------------
# 源字段:目标字段，逗号分隔；仅映射的字段会被整理到目标表
# 示例：FIELD_MAPPING=工单标题:标题,问题描述:详情,负责人:处理人,工单分类:分类,工单状态:状态
FIELD_MAPPING=

# 同步查重字段：目标表中存放「源记录 record_id」的字段名（建议文本类型，用于 upsert）
SYNC_KEY_FIELD=源记录ID

# ---------------- 群播报路由 ----------------
# 路由字段：源表中用于判断发到哪个群的字段名（如「工单分类」「负责小组」）
ROUTE_FIELD=工单分类
# 路由规则：字段值=chat_id 或 字段值=webhook:https://open.feishu.cn/open-apis/bot/v2/hook/xxx，逗号分隔
# 示例：GROUP_ROUTES=硬件类=oc_aaa,软件类=oc_bbb,其他=webhook:https://open.feishu.cn/open-apis/bot/v2/hook/xxx
GROUP_ROUTES=
# 兜底群（路由字段为空或无匹配时发到这里；chat_id 或 webhook:URL）
DEFAULT_CHAT_ID=

# 播报卡片展示用字段名
TITLE_FIELD=工单标题
STATUS_FIELD=工单状态
# 待处理状态值（每日汇总时列出该状态的工单；留空则不列待处理明细）
PENDING_STATUS=待处理

# 额外监听的字段（逗号分隔）。留空则监听「映射字段 + 状态字段 + 路由字段」，
# 仅当这些字段发生变化时才触发更新播报
WATCHED_FIELDS=

# 播报时机（create/update，逗号分隔）
BROADCAST_ON=create,update

# ---------------- 飞书事件订阅（长连接） ----------------
FEISHU_USE_LONG_CONNECTION=true
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 机器人名称
BOT_NAME=工单机器人

# ---------------- 每日汇总播报 ----------------
# cron 表达式（秒 分 时 日 月 周），留空则不启用
# 示例：每天 18:00 -> 0 0 18 * * *
CRON_SCHEDULE=
