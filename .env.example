# ============================================================
# ticket-bot 工单系统机器人配置模板
# 复制为 .env 并填写实际值；.env 不入库
# 飞书应用沿用 qianli 项目群共用应用
# ============================================================

# 服务器端口
PORT=3003

# 飞书应用配置（共用应用凭证）
APP_ID=
APP_SECRET=

# ---------------- 源表：工单录入表 ----------------
# 源表所在多维表格 app_token
BITABLE_APP_TOKEN=
# 源表 table_id（机器人监听该表的记录变更）
SOURCE_TABLE_ID=

# ---------------- 目标表：项目看板 ----------------
# 目标表所在多维表格 app_token（留空则与源表同一多维表格）
TARGET_BITABLE_APP_TOKEN=
# 目标表 table_id
TARGET_TABLE_ID=

# 同步查重字段：目标表中存放「源记录 record_id」的字段名（文本类型）
SYNC_KEY_FIELD=源记录ID
# 门控字段：仅当该字段有值时搬运到项目看板
CATEGORY_FIELD=category

# ---------------- 工单播报 ----------------
# 路由字段（多选：机械组/电控组/硬件组/宣运组/视觉组/管理层）
ROUTE_FIELD=面向组别
# 标题字段（超链接类型，展示时只取文本）
TITLE_FIELD=申请编号
# 状态字段
STATUS_FIELD=申请状态
# 待处理状态值（留空则不列待处理明细）
PENDING_STATUS=
# 播报卡片展示字段（逗号分隔）
DISPLAY_FIELDS=需求1,发起人,理想结单时间,发起人部门,相关说明
# 搬运字段映射 "源字段:目标字段,..."（category 门控搬运时的自定义映射，留空 = 不做字段映射）
FIELD_MAPPING=
# 显式监听的字段集合（逗号分隔；与映射源字段、状态字段、路由字段取并集后生效）
WATCHED_FIELDS=
# 忽略的群聊（逗号分隔 chat_id；对话能力归属其他项目机器人的群，如审批群——与网关/hub 保持一致）
IGNORE_CHAT_IDS=

# 「是否指定人员负责」分支
ASSIGN_FIELD=是否指定人员负责
ASSIGN_YES_VALUE=是
ASSIGN_NO_VALUE=否
# 指定负责人字段（人员类型）
ASSIGNEE_FIELD=指定负责人
# 接单确认后，将接单人写入源表该字段（人员类型）
SUPPLEMENT_ASSIGNEE_FIELD=补充负责人
# 人员所属组别映射（姓名或open_id:组别名），优先级最高
USER_GROUPS=

# 组别 → 群聊路由
# 格式：组别名=chat_id|webhook_url，逗号分隔。播报优先走应用机器人（chat_id），
# 应用机器人发送失败或缺失时回退群自定义机器人 webhook（接单确认依赖应用机器人事件）
GROUP_ROUTES=
# 兜底群（组别无匹配时）
DEFAULT_CHAT_ID=

# 组长映射（组别名:组长open_id或姓名），用于超时工单重问询时 @组长
GROUP_LEADERS=

# 播报时机（create/update，逗号分隔）
BROADCAST_ON=create
# 播报标记字段（写回源表，跨重启防重播；网关不可用期间的事件由每分钟对账兜底）
# 留空则禁用标记（不推荐，重启后可能重复播报）
BROADCAST_MARK_FIELD=已播报

# ---------------- 审批节点监听 ----------------
# 审批节点字段名
APPROVAL_NODE_FIELD=审批节点
# 触发播报 / 6小时未接单判断的节点值（逗号分隔多个）
# 群内有组员接单后通过=未指定负责人工单；负责人确认消息后通过=指定负责人工单
APPROVAL_NODE_ACCEPT_VALUE=群内有组员接单后通过,有组员接单后通过,负责人确认消息后通过
# 指定负责人工单的触发节点（「公示即绑定」与对账补绑定只作用于该节点的工单）
APPROVAL_NODE_ASSIGN_ACCEPT_VALUE=负责人确认消息后通过
# 触发结单提醒的节点值
APPROVAL_NODE_CLOSE_VALUE=回执单：是否结单

# ---------------- 指定负责人确认追问 ----------------
# 公示即绑定后超过 N 小时未确认 → 私聊负责人追问；负责人私聊回复「接单」
# 或群内 @机器人 发送「接单」均可完成确认（依赖网关 p2p+接单 路由规则）
ASSIGN_NUDGE_HOURS=24

# ---------------- 多人接单（无指定负责人工单） ----------------
# 工单表「是否允许多人接单」=是 时：有人接单后不即时通过审批，开放续接窗口——
# 窗口内再有人接单则合并补充负责人、重置计时并在已有人接单的群发续接询问；
# 到期无人续接才由每分钟对账自动通过全部触发节点审批（计时器为工单级，多组别共享）。
# 注意：该字段需在审批表单与工单多维表同名字段同步；工单表缺列/为空按「否」走现状（接单即通过）
MULTI_ACCEPT_FIELD=是否允许多人接单
MULTI_ACCEPT_YES_VALUE=是
# 续接窗口时长（小时）
MULTI_ACCEPT_WINDOW_HOURS=6
# 窗口截止时间写回源表的字段（不存在会自动创建，跨重启恢复计时）
MULTI_ACCEPT_WINDOW_FIELD=多人接单截止

# ---------------- 结单提醒 ----------------
# 理想结单时间字段
DEADLINE_FIELD=理想结单时间
# 理想结单时间过后 N 天才开始提醒
CLOSE_REMINDER_LEAD_DAYS=1

# ---------------- 飞书事件订阅 ----------------
# 统一由 feishu-gateway 持有长连接并转发事件到本服务 /api/feishu/event，本服务不再开长连接
FEISHU_USE_LONG_CONNECTION=false
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 机器人名称（接单提示文案中使用；须为群内可对话的应用机器人「对话型」，
# webhook 播报机器人收不到事件，不能作为 @ 对象）
BOT_NAME=爆米花机-对话型

# ---------------- 每日汇总播报 ----------------
# cron 表达式（秒 分 时 日 月 周），留空则不启用
CRON_SCHEDULE=

# ---------------- NAS 部署配置（push.js 用，严禁提交） ----------------
NAS_HOST=10.253.33.233
NAS_PORT=8500
NAS_USER=qianli
NAS_PASSWORD=

# ---------------- 工单审批联动（接单自动通过） ----------------
# 工单审批定义 code；留空 = 联动关闭
APPROVAL_CODE=
# 联动节点审批人 open_id（触发节点「群内有组员接单后通过」/「负责人确认消息后通过」
# 的审批人，节点审批人可全为同一人），机器人以该身份自动同意；逗号分隔可配多个
# （APPROVAL_AUTO_APPROVER_IDS）；单值+多值全空 = 联动关闭。
# 指定负责人工单仅限本人 @机器人 确认后才自动通过
APPROVAL_AUTO_APPROVER_ID=
# APPROVAL_AUTO_APPROVER_IDS=ou_xxx,ou_yyy

# ---------------- 私聊指令白名单（指令仅群内触发） ----------------
# /ticket-* 指令只在群聊里触发并回复到对应群；私聊指令仅白名单可用（open_id / p2p chat_id
# 任一命中即可，逗号分隔）。与对话型机器人（hub）同套变量，保持一致配置。
# P2P_COMMAND_OPEN_IDS=ou_xxx
# P2P_COMMAND_CHAT_IDS=oc_xxx
